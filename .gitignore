# ---- out/ is generated by run_analysis.jl -----------------------------------
# Ignore everything (the ZB23.RXX download caches are ~500 MB, and the
# all-peaks tables are tens of MB) ...
out/*

# ... except the duration tables the inversion workbook actually consumes, and
# their summaries. These are small and are the provenance link between the code
# and the published spreadsheet, so they are worth tracking.
!out/ZB23.N64_filtered_durations_-1205_-1200_.csv
!out/ZB23.N64_filtered_durations_-1250_-1200_.csv
!out/summary_durations_-1205_-1200.csv
!out/summary_durations_-1250_-1200.csv

# ---- imgs/: only the two figures run_analysis.jl regenerates are tracked ----
# The other PNGs are leftovers from the exploratory script and cannot be
# reproduced from this code.
imgs/*
!imgs/duration_vs_time.png
!imgs/cycle_duration_means_both.png

